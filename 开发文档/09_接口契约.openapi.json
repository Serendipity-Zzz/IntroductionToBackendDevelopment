{
  "openapi": "3.0.3",
  "info": {
    "title": "报名系统完整工程接口契约",
    "version": "1.0.0-as-built-2026-10-31",
    "description": "依据当前完整工程逆向整理，含注册与本人活动报名查询。应用pom版本仍为1.0.0；本后缀仅区分文档基线。注册字段先由服务归一化，再验证；详见字段说明。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080",
      "description": "前后端/backend，活动1与网页共享数据"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "username",
          "displayName"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "myh",
            "description": "先trim并转小写，再要求非空、最多32字符。"
          },
          "password": {
            "type": "string",
            "example": "demo123",
            "format": "password",
            "writeOnly": true,
            "maxLength": 64,
            "description": "非空；UTF-8超过72字节按登录失败处理。既有种子密码demo123可继续登录。"
          }
        },
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ]
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "expiresInSeconds": {
            "type": "integer",
            "example": 7200
          }
        },
        "additionalProperties": false,
        "required": [
          "token",
          "user",
          "expiresInSeconds"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "capacity": {
            "type": "integer"
          },
          "registeredCount": {
            "type": "integer"
          },
          "remainingSeats": {
            "type": "integer"
          },
          "myRegistrationId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "capacity",
          "registeredCount",
          "remainingSeats",
          "myRegistrationId"
        ]
      },
      "Registration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "eventId": {
            "type": "integer",
            "format": "int64"
          },
          "eventTitle": {
            "type": "string"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "description": "LocalDateTime的本地日期时间，例如2026-10-31T12:00:00；不带时区偏移，不使用要求偏移的date-time格式。"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "eventId",
          "eventTitle",
          "userId",
          "username",
          "displayName",
          "createdAt"
        ]
      },
      "RegistrationList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Registration"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "items"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "EmptyRegistration": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "additionalProperties": false,
        "required": [
          "status"
        ]
      },
      "CreateAccountRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "displayName",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "example": "charlie",
            "description": "服务端先trim并转小写，再校验[a-z][a-z0-9_]{2,31}。发送规范化的小写账号即可；不能在原始输入上用小写正则否定服务端接受的大小写归一化行为。"
          },
          "displayName": {
            "type": "string",
            "example": "陈同学",
            "description": "先strip，再要求非空、最多32字符；数据库列长50。"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "description": "非空，8至64字符，UTF-8编码不超过72字节；不返回密码。",
            "example": "classroom123",
            "format": "password",
            "writeOnly": true
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "检查Java进程",
        "tags": [
          "报名课堂"
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "headers": {
              "X-Request-Id": {
                "description": "服务端生成的请求追踪ID",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "未预期的业务服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
